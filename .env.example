# Скопируйте этот файл в .env и заполните значения.
# .env не коммитится в git — пароль остаётся только на сервере.

ADMIN_PASSWORD=
PORT=3000

# Cookie сессии админки по умолчанию ставится с флагом Secure — сервер
# должен быть за HTTPS. Для локальной разработки по обычному http://
# раскомментируйте строку ниже:
# COOKIE_SECURE=false
